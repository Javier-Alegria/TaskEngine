<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.taskengine.taskengine.MainController"
            prefWidth="1500" prefHeight="1000">

    <stylesheets>
        <URL value="@dataforge.css"/>
    </stylesheets>

    <!-- ========================================= -->
    <!--       CABECERA (LOGO Y MODO OSCURO)       -->
    <!-- ========================================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="12" right="14" bottom="10" left="14"/>
            </padding>
            <VBox spacing="2" prefWidth="350">
                <HBox>
                    <Label text="TASK ENGINE" styleClass="logo-main"/>
                </HBox>
                <Label text="Multi-Process Task Engine" styleClass="logo-main"/>
                <Label text="RA1 – Programación de Servicios y Procesos" styleClass="logo-main"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnModoOscuro"  styleClass="btnModoNoche" onAction="#activarDesactivarModoNoche">
                <graphic>
                    <Region styleClass="icono-modo"/>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- ========================================= -->
    <!--            CONTENIDO PRINCIPAL            -->
    <!-- ========================================= -->
    <center>
        <VBox spacing="11">
            <padding>
                <Insets right="14" left="14"/>
            </padding>

            <!-- fila 1 (Paneles 1 al 4) -->
            <HBox spacing="11" prefHeight="230">
                <!-- Panel 1: Selección de tarea -->
                <VBox spacing="10" prefWidth="313" HBox.hgrow="ALWAYS" styleClass="card">
                    <Label text="1. SELECCIÓN DE TAREA" styleClass="section-title"/>
                    <Label text="Tipo de tarea:" styleClass="textoAuxiliar"/>
                    <ComboBox fx:id="cmbTarea" value="Text Analyzer" maxWidth="Infinity">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Text Analyzer"/>
                                <String fx:value="Prime Benchmark"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                    <Label fx:id="lblDescripcion" wrapText="true"/>
                </VBox>

                <!-- Panel 2: Configuración de la ejecución -->
                <VBox spacing="8" prefWidth="475" HBox.hgrow="ALWAYS" styleClass="card">
                    <Label text="2. CONFIGURACIÓN DE LA EJECUCIÓN" styleClass="section-title"/>
                    <VBox fx:id="cajaFichero" spacing="8">
                        <Label text="Fichero de entrada:"/>
                        <HBox spacing="10">
                            <TextField fx:id="txtFichero" promptText="C:\Ruta\del\fichero" editable="false" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnExaminar" text="Examinar..." onAction="#examinarFicheroLlamada1"/>
                        </HBox>
                    </VBox>
                    <VBox fx:id="configTextAnalyzer" spacing="8">
                        <VBox fx:id="cajaTextoStdin" spacing="8">
                            <Label text="Texto a enviar por stdin:" styleClass="textoAuxiliar"/>
                            <TextArea fx:id="txtTextoStdin" prefRowCount="3" wrapText="true"
                                      promptText="Escribe aquí el texto que analizará Text Analyzer"/>
                        </VBox>
                        <Label text="Palabra a buscar:" styleClass="textoAuxiliar"/>
                        <TextField fx:id="txtPalabra" promptText="Palabra"/>
                    </VBox>
                    <VBox fx:id="configPrimeBenchmark" spacing="8">
                        <Label text="Límite N:"/>
                        <TextField fx:id="txtLimiteN" promptText="Ej.: 500000"/>
                    </VBox>
                </VBox>

                <!-- Panel 3: Modo de ejecución -->
                <VBox spacing="10" prefWidth="305" HBox.hgrow="ALWAYS" styleClass="card">
                    <fx:define>
                        <ToggleGroup fx:id="grupoModo"/>
                    </fx:define>
                    <Label text="3. MODO DE EJECUCIÓN" styleClass="section-title"/>
                    <Label text="Modo:" styleClass="textoAuxiliar"/>
                    <HBox>
                        <ToggleButton fx:id="tglSecuencial" text="SECUENCIAL" toggleGroup="$grupoModo" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#actualizarModoFooter"/>
                        <ToggleButton fx:id="tglParalelo" text="PARALELO" selected="true" toggleGroup="$grupoModo" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#actualizarModoFooter"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Número de procesos:" styleClass="textoAuxiliar"/>
                        <Spinner fx:id="spnProcesos" min="1" max="100" initialValue="10" editable="true"/>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button fx:id="btnIniciar" text="Iniciar ejecución" maxWidth="Infinity" onAction="#iniciarEjecucion"/>
                </VBox>

                <!-- Panel 4: Redirecciones -->
                <VBox spacing="10" prefWidth="340" HBox.hgrow="ALWAYS" styleClass="card">
                    <Label text="4. REDIRECCIONES" styleClass="section-title"/>
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="50"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="stdout:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="textoAuxiliar"/>
                        <ComboBox fx:id="cmbStdout" value="Capturar en la aplicación" maxWidth="Infinity" onAction="#cambiarRedireccion" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Capturar en la aplicación"/>
                                    <String fx:value="Guardar en fichero"/>
                                    <String fx:value="Descartar"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <Label text="stderr:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="textoAuxiliar"/>
                        <ComboBox fx:id="cmbStderr" value="Capturar en la aplicación" maxWidth="Infinity" onAction="#cambiarRedireccion" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Capturar en la aplicación"/>
                                    <String fx:value="Guardar en fichero"/>
                                    <String fx:value="Descartar"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <Label text="stdin:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="textoAuxiliar"/>
                        <ComboBox fx:id="cmbStdin" value="Desde la aplicación" maxWidth="Infinity" onAction="#cambiarRedireccion" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Desde la aplicación"/>
                                    <String fx:value="Leer desde fichero"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </GridPane>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Separator/>
                    <TitledPane fx:id="tpRedirecciones" text="Redirección avanzada a archivos" expanded="false">
                        <VBox spacing="8">
                            <TextField fx:id="txtArchivoStdout" promptText="Ruta de archivo para stdout"/>
                            <TextField fx:id="txtArchivoStderr" promptText="Ruta de archivo para stderr"/>
                        </VBox>
                    </TitledPane>
                </VBox>
            </HBox>

            <!-- Panel 5: Monitor de procesos -->
            <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="5. MONITOR DE PROCESOS" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnDetener" text="Detener ejecución" onAction="#detenerEjecucion"/>
                </HBox>
                <TableView fx:id="tblProcesos" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No hay procesos todavía"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colPid" text="PID" prefWidth="90"/>
                        <TableColumn fx:id="colTarea" text="Tarea" prefWidth="160"/>
                        <TableColumn fx:id="colParametros" text="Parámetros" prefWidth="340"/>
                        <TableColumn fx:id="colInicio" text="Inicio" prefWidth="120"/>
                        <TableColumn fx:id="colFin" text="Fin" prefWidth="120"/>
                        <TableColumn fx:id="colTiempo" text="Tiempo (ms)" prefWidth="100"/>
                        <TableColumn fx:id="colCodigoSalida" text="Código salida" prefWidth="110"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Fila 3: paneles 6 a 8 -->
            <HBox spacing="11" prefHeight="205">
                <!-- Panel 6: Salida estándar -->
                <VBox spacing="8" prefWidth="397" HBox.hgrow="ALWAYS" styleClass="card">
                    <Label text="6. SALIDA ESTÁNDAR (stdout)" styleClass="section-title"/>
                    <StackPane VBox.vgrow="ALWAYS">
                        <TextArea fx:id="txtStdout" editable="false" promptText="Salida estándar del proceso" />
                        <Button fx:id="btnLimpiarStdout" text="Limpiar" onAction="#limpiarTexto" StackPane.alignment="BOTTOM_RIGHT">
                            <StackPane.margin><Insets right="10" bottom="8"/></StackPane.margin>
                        </Button>
                    </StackPane>
                </VBox>

                <!-- Panel 7: Salida de error -->
                <VBox spacing="8" prefWidth="405" HBox.hgrow="ALWAYS" styleClass="card">
                    <Label text="7. SALIDA DE ERROR (stderr)" styleClass="section-title"/>
                    <StackPane VBox.vgrow="ALWAYS">
                        <TextArea fx:id="txtStderr" editable="false" wrapText="true" promptText="Salida de error del proceso" />
                        <Button fx:id="btnLimpiarStderr" text="Limpiar" onAction="#limpiarTexto" StackPane.alignment="BOTTOM_RIGHT">
                            <StackPane.margin><Insets right="10" bottom="8"/></StackPane.margin>
                        </Button>
                    </StackPane>
                </VBox>

                <!-- Panel 8: Información general -->
                <VBox spacing="8" prefWidth="649" HBox.hgrow="ALWAYS" styleClass="card">
                    <Label text="8. INFORMACIÓN GENERAL" styleClass="section-title"/>
                    <HBox spacing="14" VBox.vgrow="ALWAYS">
                        <GridPane hgap="16" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Procesos ejecutados:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="lblEjecutados" text="0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Procesos finalizados:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="lblFinalizados" text="0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Procesos en ejecución:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="lblEnEjecucion" text="0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Procesos con error:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="lblConError" text="0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Tiempo total (lote):"/>
                                <Label fx:id="lblTiempoTotal" text="00:00:00.000"/>
                            </HBox>
                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <ProgressBar fx:id="pgbLote" progress="0.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblPorcentaje" text="0%"/>
                            </HBox>

                            <!-- Exportar resultados -->
                            <VBox fx:id="cajaExportar" spacing="8">
                                <Label text="Exportar resultados: "/>
                                <HBox spacing="10">
                                    <TextField fx:id="txtFicheroExportar" promptText="C:\Ruta\del\fichero" editable="false" HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnExaminarExportar" text="Examinar..." onAction="#examinarFicheroLlamada2"/>
                                </HBox>
                            </VBox>
                            <Button fx:id="btnExportar" onAction="#onExportarResultados" text="Exportar resultados..."/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <!-- ========================================= -->
    <!--             BARRA TAREAS ABAJO            -->
    <!-- ========================================= -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="70">
            <padding>
                <Insets top="9" right="22" bottom="9" left="22"/>
            </padding>
            <Label fx:id="lblUsuario" text="Usuario: Alumno" styleClass="textoAuxiliar"/>
            <Label fx:id="lblModo" text="Modo: PARALELO" styleClass="textoAuxiliar"/>
            <Label fx:id="lblProcesos" text="Procesos: -" styleClass="textoAuxiliar"/>
            <Label fx:id="lblInicio" styleClass="textoAuxiliar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Task Engine v1.0" styleClass="textoAuxiliar"/>
        </HBox>
    </bottom>

</BorderPane>

